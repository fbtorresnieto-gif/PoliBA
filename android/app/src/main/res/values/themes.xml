<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MultiPro" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/multipro_primary</item>
        <item name="colorPrimaryContainer">@color/multipro_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/multipro_surface</item>
        <item name="colorOnSurface">@color/multipro_dark</item>
        <item name="colorOnSurfaceVariant">@color/multipro_text</item>
        <item name="android:textColor">@color/multipro_dark</item>
        <item name="android:textColorHint">@color/multipro_text</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/multipro_dark</item>
        <item name="android:navigationBarColor">@color/multipro_dark</item>
    </style>
    <style name="ProfileLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/multipro_text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ProfileValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/multipro_dark</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="ProfileValueLast" parent="ProfileValue">
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="MultiProInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/multipro_text</item>
        <item name="boxStrokeColor">@color/multipro_primary_dark</item>
        <item name="boxBackgroundColor">@color/multipro_surface</item>
        <item name="endIconTint">@color/multipro_dark</item>
        <item name="errorTextColor">@color/multipro_error</item>
    </style>
    <style name="MultiProInputText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/multipro_dark</item>
        <item name="android:textColorHint">@color/multipro_text</item>
        <item name="android:textCursorDrawable">@drawable/multipro_text_cursor</item>
    </style>
    <style name="MultiProDatePickerDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/multipro_primary_dark</item>
        <item name="android:windowBackground">@color/multipro_surface</item>
        <item name="android:textColorPrimary">@color/multipro_dark</item>
        <item name="android:textColorSecondary">@color/multipro_text</item>
        <item name="android:datePickerStyle">@style/MultiProDatePicker</item>
    </style>
    <style name="MultiProDatePicker" parent="android:style/Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/multipro_dark</item>
        <item name="android:calendarTextColor">@color/multipro_dark</item>
        <item name="android:dayOfWeekBackground">@color/multipro_surface</item>
    </style>
    <style name="RegisterField" parent="MultiProInputLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>
    <style name="DrawerMenuButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/multipro_dark</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
