<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/drawerLayout"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/multipro_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="88dp"
            android:background="@color/multipro_primary" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="20dp"
            android:elevation="5dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/menuButton"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="52dp"
                android:layout_height="52dp" android:contentDescription="@string/open_menu"
                android:text="☰" android:textColor="@color/white" android:textSize="27sp"
                app:cornerRadius="16dp" />
            <ImageView android:layout_width="148dp" android:layout_height="51dp"
                android:layout_marginStart="10dp" android:adjustViewBounds="true"
                android:contentDescription="@string/brand_logo_description" android:scaleType="fitCenter"
                android:src="@drawable/multipro_logo" />
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.core.widget.NestedScrollView android:id="@+id/contentScroll"
                android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="26dp"
                    android:paddingEnd="20dp" android:paddingBottom="32dp">
                    <TextView android:id="@+id/greetingText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="@color/multipro_dark"
                        android:textSize="28sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="@string/home_news_subtitle"
                        android:textColor="@color/multipro_text" android:textSize="16sp" />
                    <View android:layout_width="54dp" android:layout_height="4dp"
                        android:layout_marginTop="14dp" android:background="@color/multipro_primary" />
                    <LinearLayout android:id="@+id/listContainer" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="24dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            <LinearLayout android:id="@+id/stateContainer" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
                android:padding="32dp">
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressIndicator" android:layout_width="48dp" android:layout_height="48dp"
                    app:indicatorColor="@color/multipro_primary" />
                <TextView android:id="@+id/stateText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center"
                    android:text="@string/loading_data" android:textColor="@color/multipro_text" android:textSize="16sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/retryButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="@string/retry" android:textAllCaps="false"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:id="@+id/drawerPanel"
        android:layout_width="310dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:background="@color/multipro_surface"
        android:clickable="true" android:elevation="16dp" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="28dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/multipro_primary" android:orientation="vertical"
                android:paddingStart="24dp" android:paddingTop="34dp" android:paddingEnd="24dp"
                android:paddingBottom="24dp">
                <ImageView android:layout_width="160dp" android:layout_height="55dp"
                    android:adjustViewBounds="true" android:contentDescription="@string/brand_logo_description"
                    android:src="@drawable/multipro_logo" />
                <TextView android:id="@+id/drawerNameText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="24dp"
                    android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/drawerRoleText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:textColor="#EAF4F6" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/drawerEmailText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="3dp"
                    android:textColor="#EAF4F6" android:textSize="14sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="24dp" android:paddingTop="22dp" android:paddingEnd="24dp"
                android:paddingBottom="8dp" android:text="@string/menu_title"
                android:textColor="@color/multipro_text_muted" android:textSize="13sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/drawerExploreButton"
                style="@style/DrawerMenuButton" android:text="@string/explore_spaces" />
            <com.google.android.material.button.MaterialButton android:id="@+id/drawerReservationsButton"
                style="@style/DrawerMenuButton" android:text="@string/my_reservations" />
            <com.google.android.material.button.MaterialButton android:id="@+id/drawerModulesButton"
                style="@style/DrawerMenuButton" android:text="@string/my_modules" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/drawerProfileButton"
                style="@style/DrawerMenuButton" android:text="@string/my_profile" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="24dp" android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp" android:background="@color/multipro_border" />
            <com.google.android.material.button.MaterialButton android:id="@+id/drawerLogoutButton"
                style="@style/DrawerMenuButton" android:layout_marginTop="12dp" android:text="@string/logout"
                android:textColor="@color/multipro_error" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
